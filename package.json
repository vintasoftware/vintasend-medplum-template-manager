{
  "name": "vintasend-medplum-template-manager",
  "version": "1.0.0-alpha7",
  "description": "Medplum/FHIR storage for VintaSend managed templates, using MessageDefinition resources.",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "author": "Vinta Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-medplum-template-manager.git"
  },
  "peerDependencies": {
    "@medplum/core": "^5.1.1",
    "@medplum/fhirtypes": "^5.1.1",
    "vintasend": "^1.0.0-alpha7",
    "vintasend-managed-templates": "1.0.0-alpha7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@medplum/core": "^5.2.11",
    "@medplum/definitions": "^5.2.11",
    "@medplum/fhirtypes": "^5.2.11",
    "@medplum/mock": "^5.2.11",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "^7.0.2",
    "vintasend": "^1.0.0-alpha7",
    "vintasend-managed-templates": "^1.0.0-alpha7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
