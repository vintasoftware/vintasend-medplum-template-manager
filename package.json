{
  "name": "vintasend-medplum-template-manager",
  "version": "1.0.0-alpha5",
  "description": "Medplum/FHIR storage for VintaSend managed templates, using MessageDefinition resources.",
  "type": "module",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "author": "Vinta Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vintasend-medplum-template-manager.git"
  },
  "peerDependencies": {
    "@medplum/core": "^5.1.1",
    "@medplum/fhirtypes": "^5.1.1",
    "vintasend": "^1.0.0-alpha5",
    "vintasend-managed-templates": "1.0.0-alpha5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@medplum/core": "^5.1.1",
    "@medplum/definitions": "^5.1.1",
    "@medplum/fhirtypes": "^5.1.1",
    "@medplum/mock": "^5.1.1",
    "@types/node": "^25.0.8",
    "@vitest/coverage-v8": "4.0.18",
    "typescript": "^5.9.3",
    "vintasend": "^1.0.0-alpha5",
    "vintasend-managed-templates": "^1.0.0-alpha5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  }
}
